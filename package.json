{
  "name": "sound-of-knowledge",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "npm run check:projects && playwright test",
    "check:projects": "tsx scripts/check-projects.ts",
    "test:soak": "playwright test tests/e2e/soak.spec.ts",
    "audio:check": "tsx scripts/render-audio.ts",
    "og:image": "tsx scripts/make-og-image.ts",
    "bench": "tsx scripts/bench.ts",
    "probe:stream": "tsx scripts/probe-stream.ts",
    "probe:shader": "tsx scripts/probe-shader-compile.ts",
    "gen:synthetic": "tsx scripts/gen-synthetic.ts",
    "build:workers": "node scripts/build-workers.mjs",
    "build:workers:watch": "node scripts/build-workers.mjs --watch",
    "predev": "npm run build:workers",
    "dev": "run-p build:workers:watch dev:next",
    "dev:next": "next dev",
    "prebuild": "npm run build:workers",
    "build": "next build",
    "start": "next start",
    "check:docs": "tsx scripts/check-docs.ts",
    "check": "npm run typecheck && npm run lint && npm run check:projects && npm run check:docs && npm run test"
  },
  "dependencies": {
    "@vercel/analytics": "1.6.1",
    "@vercel/speed-insights": "1.3.1",
    "next": "16.1.6",
    "postprocessing": "6.39.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "24.19.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.3",
    "eslint-config-next": "16.1.6",
    "npm-run-all2": "8.0.4",
    "prettier": "3.9.10",
    "sharp": "^0.34.5",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
